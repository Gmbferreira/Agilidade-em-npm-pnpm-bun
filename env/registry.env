# Aponta npm, pnpm e Bun para o Verdaccio local.
# Uso: set -a; source env/registry.env; set +a
# Cada gerenciador lê uma variável diferente (verificado em 19/11/2026):
#   npm  -> NPM_CONFIG_REGISTRY
#   pnpm -> PNPM_CONFIG_REGISTRY (o pnpm 12 IGNORA NPM_CONFIG_REGISTRY)
#   Bun  -> BUN_CONFIG_REGISTRY
NPM_CONFIG_REGISTRY=http://127.0.0.1:4873/
PNPM_CONFIG_REGISTRY=http://127.0.0.1:4873/
BUN_CONFIG_REGISTRY=http://127.0.0.1:4873/
